# Physical-Engineering's Last Exam (PLE) — Environment Configuration Template
# Copy this file to .env for local testing.
# NOTE: Official competition evaluation uses Google-sponsored models with zero API cost.
# Never commit a real .env containing API keys to a public repository!

# Optional: Custom model endpoint or local proxy (e.g. for LiteLLM or local vLLM)
# MODEL_PROXY_URL=http://localhost:8000/v1
# MODEL_PROXY_KEY=sk-local-test

# Optional: Provider keys for local testing of non-sponsored models
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: Hugging Face token for downloading dev tasks cache
# HF_TOKEN=

# Logging level (debug, info, warning, error)
LOG_LEVEL=info
